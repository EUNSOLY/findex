#!/bin/sh
#
# ===============================================================
# [commit-msg 훅]
# ===============================================================
# 언제 실행되나:
#   git commit 할 때, 커밋 메시지를 작성한 "직후" + 커밋이 실제로 만들어지기 "직전"에 git이 자동 실행
#   (실행 순서: pre-commit → 커밋 메시지 작성 → commit-msg → 커밋 완료)
#
# 무엇을 하나:
#   커밋 메시지가 팀 규칙(이모지 + 타입 + 제목)에 맞는지 검사하고, 틀리면 커밋을 막는다.
#
# git이 넘겨주는 값:
#   $1 = 작성한 커밋 메시지가 임시로 저장된 파일 경로 (보통 .git/COMMIT_EDITMSG)
#
# 종료 코드:
#   0         → 통과, 커밋 진행
#   0이 아님  → 실패, 커밋 취소
#
# 설치 위치:
#   원본은 scripts/commit-msg, Run(컴파일) 시 build.gradle의 updateGitHooks 태스크가 .git/hooks/로 복사
# ===============================================================

# -e : 명령 하나라도 실패하면 즉시 스크립트 종료
# -u : 정의 안 된 변수를 쓰면 에러 (오타로 빈 값이 들어가는 실수 방지)
set -eu

# ---------------------------------------------------------------
# 1) 커밋 메시지 읽기
# ---------------------------------------------------------------
commit_msg_file="$1" # 커밋 메시지 임시 파일 경로

# sed -n '1{...;p;}' : 1번째 줄만 출력 / s/\r$// : 줄 끝의 \r 제거 (Windows에서 만든 CRLF 대비)
header="$(sed -n '1{s/\r$//;p;}' "$commit_msg_file")"       # 첫째 줄 = 커밋 제목
second_line="$(sed -n '2{s/\r$//;p;}' "$commit_msg_file")"  # 둘째 줄 = 비어 있어야 함 (본문은 셋째 줄부터)

# ---------------------------------------------------------------
# 2) 규칙 정의
# ---------------------------------------------------------------
max_header_length=50                                      # 제목 최대 글자 수
type_pattern='(✨feat|🐛bug|🩹fix|📝docs|🔧chore)'       # 허용하는 <이모지><타입> 목록 (gitmoji 기준)

# 제목 전체 형식 (정규식)
#   ^${type_pattern}  : 허용 타입으로 시작
#   (\([^()]+\))?     : 괄호로 감싼 범위는 선택 사항  예) (auth)
#   : .+$             : 콜론 + 공백 뒤에 제목이 한 글자 이상
header_pattern="^${type_pattern}(\([^()]+\))?: .+$"

# ---------------------------------------------------------------
# 3) 실패 시 안내 메시지 출력 후 커밋 중단
# ---------------------------------------------------------------
# { ... } >&2 : 안내 문구를 에러 출력(stderr)으로 보냄 (git/IntelliJ가 에러 메시지로 표시)
fail() {
  {
    echo ""
    echo "커밋 메시지 규칙을 확인해주세요."
    echo "오류: $1"
    echo ""
    echo "형식: <이모지><타입>(선택 범위): <제목>"
    echo "허용 타입:"
    echo "  ✨feat   신규 기능 개발"
    echo "  🐛bug    버그 수정 (의도와 다르게 동작하던 것을 고침)"
    echo "  🩹fix    버그가 아닌 코드 수정, 간단한 수정"
    echo "  📝docs   문서 추가/수정 (README, 주석 등)"
    echo "  🔧chore  환경설정, 빌드/의존성 등 코드 로직 외 작업"
    echo ""
    echo "예시:"
    echo "  ✨feat(index): 지수 조회 API 추가"
    echo "  🐛bug(auth): 토큰 만료 시 500 에러 수정"
    echo "  📝docs: 코드 품질 가이드 추가"
    echo "  🔧chore(gradle): checkstyle 설정"
    echo ""
    echo "규칙:"
    echo "  - 첫째 줄은 ${max_header_length}자 이내로 작성"
    echo "  - 제목은 명령형/현재형으로 작성 (추가함 X, 추가 O)"
    echo "  - 본문이 필요한 경우 둘째 줄을 비우고 셋째 줄부터 작성"
    echo "  - 하나의 커밋에는 하나의 작업만 포함"
  } >&2
  exit 1
}

# ---------------------------------------------------------------
# 4) 예외: merge, revert 커밋은 검사하지 않음
# ---------------------------------------------------------------
# git이 "Merge branch ..." / "Revert "..."" 메시지를 자동으로 만들기 때문
case "$header" in
  Merge\ *|Revert\ \"*)
    exit 0
    ;;
esac

# ---------------------------------------------------------------
# 5) 제목이 비어 있는지 검사
# ---------------------------------------------------------------
# -z : 문자열이 비어 있으면 참
if [ -z "$header" ]; then
  fail "첫째 줄에 커밋 제목이 없습니다."
fi

# ---------------------------------------------------------------
# 6) 제목 글자 수 검사
# ---------------------------------------------------------------
# 한글/이모지는 UTF-8에서 여러 바이트로 저장됨 (한글 3바이트, 이모지 4바이트)
# UTF-8에서 한 글자의 "두 번째 바이트부터"는 항상 \200~\277(0x80~0xBF) 범위이므로,
# 그 바이트들을 지우고(tr -d) 남은 바이트 수(wc -c)를 세면 = 글자 수
# LC_ALL=C : 로케일과 상관없이 항상 바이트 단위로 처리하도록 고정
#   (wc -m은 로케일이 C인 환경(IntelliJ, GUI 클라이언트 등)에서 바이트를 세서 한글 제목이 길게 계산됨)
title_length="$(printf '%s' "$header" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')"
if [ "$title_length" -gt "$max_header_length" ]; then
  fail "첫째 줄은 ${max_header_length}자 이내여야 합니다. (현재 ${title_length}자)"
fi

# ---------------------------------------------------------------
# 7) 제목 형식 검사 (이모지 + 타입 + 범위 + ": " + 제목)
# ---------------------------------------------------------------
# grep -E : 확장 정규식 사용 / -q : 결과 출력 없이 매칭 여부만 확인
if ! printf '%s\n' "$header" | grep -Eq "$header_pattern"; then
  fail "첫째 줄 형식이 올바르지 않습니다."
fi

# ---------------------------------------------------------------
# 8) 제목 어미 검사 (명령형/현재형인지)
# ---------------------------------------------------------------
# "✨feat(auth): " 부분을 잘라내고 순수 제목만 남김
subject="$(printf '%s\n' "$header" | sed -E "s/^${type_pattern}(\([^()]+\))?: //")"

# 제목이 과거형/완료형 어미로 끝나면 실패
case "$subject" in
  *함|*했음|*했습니다|*했다|*하였다|*하였음)
    fail "제목은 명령형/현재형으로 작성해주세요. 예: 추가함 X, 추가 O"
    ;;
esac

# ---------------------------------------------------------------
# 9) 둘째 줄이 비어 있는지 검사
# ---------------------------------------------------------------
# 둘째 줄에 내용이 있으면 실패 (단, git이 자동으로 넣는 # 주석 줄은 허용)
# -n : 문자열이 비어 있지 않으면 참
if [ -n "$second_line" ] && ! printf '%s\n' "$second_line" | grep -Eq '^[[:space:]]*#'; then
  fail "본문을 작성하려면 제목 아래 둘째 줄을 비워야 합니다."
fi

# 모든 검사 통과 → 커밋 진행
exit 0
